# Example defaults use the optional dedicated account and virtual environment.
# Adjust User, Group, WorkingDirectory, and ExecStart for the deployment site.

[Unit]
Description=ASKAP/MWA FRB UDP to buffer and all-sky VCS trigger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=askap-mwa-trigger
Group=askap-mwa-trigger
WorkingDirectory=/opt/askap-mwa-frb-trigger
EnvironmentFile=/etc/askap-mwa-trigger.env
UMask=0077
ExecStart=/opt/askap-mwa-frb-trigger/.venv/bin/python3 /opt/askap-mwa-frb-trigger/udp_to_triggerbuffer.py \
    224.1.1.1:4900 \
    --past-seconds 120 \
    --obstime 600 \
    --min-sn 20 \
    --min-dm 0 \
    --burst-window 1 \
    --burst-max-count 10 \
    -v

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
